rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──
    // Setiap user hanya bisa baca & tulis dokumennya sendiri
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Claims disimpan sebagai array field `claims` di dalam dokumen user,
      // jadi otomatis ter-cover oleh rule di atas.

      // Progres penggunaan fitur AI per user (mis. limit harian receipt-to-excel)
      match /usage/{feature} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Jobs collection (AI agents) ──
    // Metadata job hanya bisa diakses oleh pemiliknya. Seluruh penulisan
    // dilakukan via Firebase Admin SDK (server-side); rules ini adalah
    // pertahanan berlapis agar klien tidak pernah bisa mengubah job orang lain.
    match /jobs/{jobId} {
      allow read, write: if
        request.auth != null &&
        (
          request.resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        );
      allow list: if request.auth != null;
    }

    // ── Payments collection ──
    match /payments/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if request.auth != null;
    }

  }
}
