rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──
    // Setiap user hanya bisa baca & tulis dokumennya sendiri
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Claims disimpan sebagai array field `claims` di dalam dokumen user,
      // jadi otomatis ter-cover oleh rule di atas.
    }

    // ── Payments collection ──
    match /payments/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if request.auth != null;
    }

  }
}
