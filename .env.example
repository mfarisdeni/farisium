# ── Farisium Environment Configuration ──
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and MUST NOT be committed.

# ── Firebase Configuration (Required) ──
# Public-safe keys exposed to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (Server-side, Optional) ──
# Required only for server-side Firebase operations (e.g., admin API).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=

# ── Site URL ──
# Local: http://localhost:3000
# Production: https://farisium.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Analytics (Optional) ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Google AdSense (Optional) ──
# Publisher ID dari akun AdSense kamu (format: ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── AI Backend API (Optional for dev) ──
# Internal API endpoint for AI generation (Stable Diffusion).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── KlikQRIS (Required for Payment) ──
# Mode: "sandbox" atau "production"
KLIKQRIS_MODE=sandbox
NEXT_PUBLIC_KLIKQRIS_MODE=sandbox

# ── LLM Gateway (AI Model) ──
# URL publik LLM Gateway (wajib)
LLM_API_URL=https://llm-api.farisium.com
# API Key dari LLM Gateway (wajib, jangan mulai dengan NEXT_PUBLIC_)
LLM_API_KEY=
# Model yang digunakan (default: llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b
# Biaya per generate dalam FRSC (default: 1)
SEO_CAPTION_COST=1

# ── Fium Gateway (AI Chat Assistant) ──
# URL publik Fium Gateway (wajib)
FIUM_API_URL=https://fium-api.farisium.com
# API Key dari Fium Gateway (wajib, jangan mulai dengan NEXT_PUBLIC_)
FIUM_API_KEY=
# Model yang digunakan (default: llama3.2:3b)
FIUM_MODEL=llama3.2:3b
# Batas harian gratis (default: 20)
FIUM_DAILY_FREE_LIMIT=20
# Riwayat chat maksimal yang dikirim ke model (default: 8)
FIUM_MAX_HISTORY=8

# ── Resend (Email Notifications) ──
# API Key dari https://resend.com
RESEND_API_KEY=
# Domain terverifikasi di Resend, misal: "Farisium <noreply@farisium.com>"
EMAIL_FROM=Farisium <noreply@farisium.com>
# Tujuan notifikasi admin
NOTIFICATION_EMAIL=hello@farisium.com
